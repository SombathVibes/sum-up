// The bot on Cloudflare Workers (branch `cloudflare`; main stays on Telegram
// Serverless). cloudflare/README.md has the steps: npm run cf:gen, create the
// D1 database, set the secrets, deploy, then POST /setup for the webhook.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sumup-bot",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-01",
  // The bot code imports Telegram Serverless's `sdk`; here it's cloudflare/sdk.
  "alias": {
    "sdk": "./cloudflare/sdk/index.js",
    "sdk/api": "./cloudflare/sdk/index.js",
    "sdk/fetch": "./cloudflare/sdk/index.js",
    "sdk/db": "./cloudflare/sdk/db.js"
  },
  // The admin Mini App (npm run build); /telegram, /api/* and /setup reach the Worker first.
  "assets": {
    "directory": "./webapp/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/telegram", "/api/*", "/setup"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      // In Western Europe (`npx wrangler d1 create sumup-eu --location weur`): next to
      // Telegram's servers, where the webhook runs. (The first one, `sumup`, was in
      // Asia-Pacific: every query crossed Europe↔Asia, ~180 ms each.)
      "database_name": "sumup-eu",
      "database_id": "a82412f1-461f-4439-9b80-7c3af144d932",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  // Always runs the Worker in Amsterdam (Azure West Europe), next to D1 and to
  // Telegram's servers, rather than next to whoever made the request: the Mini
  // App from Asia then makes one long trip per request instead of one per query
  // (in Phnom Penh, a group list took 8 s). Smart Placement never moved it.
  "placement": { "region": "azure:westeurope" },
  // 🖼 the agent day images: Cloudflare's headless browser screenshots the page
  // (lib/sheetimage.js). Free plan: 10 browser-minutes a day, one every 10 s.
  "browser": { "binding": "BROWSER" },
  // Every minute: the lottery logins' schedule and yesterday's agent days.
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true }
}
